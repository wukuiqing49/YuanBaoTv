<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:paddingStart="48dp"
    android:paddingTop="12dp"
    android:paddingEnd="48dp"
    android:paddingBottom="@dimen/feature_res_spacing_large">

    <!-- 顶部标题与分类过滤栏 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">



        <!-- 筛选 Tab 按钮组 -->
        <LinearLayout
            android:id="@+id/ll_filter_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="0dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:nextFocusDown="@id/et_library_search"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_all_media"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/btn_filter_cartoon"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:nextFocusDown="@id/et_library_search"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_cartoon"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/btn_filter_tv"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:nextFocusDown="@id/et_library_search"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_tv"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/btn_filter_movie"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textAllCaps="false"
                android:nextFocusDown="@id/et_library_search"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_movie"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
        <include android:id="@+id/library_tools" layout="@layout/layout_library_tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ui_item_gap" />
    </LinearLayout>

    <!-- 媒体多列网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_media_grid" android:paddingHorizontal="@dimen/ui_focus_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/feature_res_spacing_small"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:spanCount="5"
        tools:listitem="@layout/item_poster_card"  android:paddingTop="@dimen/ui_focus_padding" android:paddingBottom="@dimen/ui_focus_padding" />

    <LinearLayout
        android:id="@+id/layout_empty_library"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <ProgressBar android:id="@+id/progress_library" android:layout_width="40dp" android:layout_height="40dp" android:indeterminateTint="@color/tv_accent_cyan" />
        <ImageView android:id="@+id/iv_empty_library" android:layout_width="72dp" android:layout_height="72dp" android:importantForAccessibility="no" android:scaleType="centerInside" android:padding="@dimen/feature_res_spacing_medium" android:background="@drawable/bg_glass_card" android:src="@drawable/ic_tv_library" />
        <TextView android:id="@+id/tv_empty_library_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/library_empty_title" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_title" android:textStyle="bold" />
        <TextView android:id="@+id/tv_empty_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxLines="3" android:text="@string/library_empty_message" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_body" />
        <Button android:id="@+id/btn_empty_library_action" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="0dp" android:background="@drawable/bg_hero_play_btn" android:minWidth="152dp" android:text="@string/btn_add_nas" android:textColor="@color/home_primary_text" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
