<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/card_container" android:layout_width="@dimen/ui_continue_width" android:layout_height="wrap_content"
 android:layout_marginEnd="@dimen/feature_res_spacing_medium" android:padding="4dp" android:focusable="true"
 android:background="@drawable/bg_poster_surface" android:foreground="@drawable/bg_card_focus_foreground">
 <ImageView android:id="@+id/iv_thumbnail" android:layout_width="0dp" android:layout_height="0dp"
 android:background="@drawable/bg_poster_image_surface" android:clipToOutline="true" android:scaleType="centerCrop"
 app:layout_constraintDimensionRatio="16:9" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <FrameLayout android:id="@+id/fl_center_play_btn" android:layout_width="40dp" android:layout_height="40dp" android:alpha="0"
 android:background="@drawable/bg_glass_card" app:layout_constraintTop_toTopOf="@id/iv_thumbnail" app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail"
 app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
 <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_tv_play"/></FrameLayout>
 <ProgressBar android:id="@+id/pb_progress" android:layout_marginHorizontal="12dp" android:layout_marginBottom="4dp" style="?android:attr/progressBarStyleHorizontal"
 android:layout_width="0dp" android:layout_height="3dp" android:max="100" android:progressTint="@color/tv_accent_cyan"
 android:progressBackgroundTint="@color/tv_control_surface" app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail"
 app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp"
 android:layout_marginHorizontal="4dp" android:minHeight="@dimen/ui_card_title_block_height" app:lineHeight="@dimen/ui_card_title_line_height" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"
 android:textSize="@dimen/ui_text_body" android:fontFamily="sans-serif-medium" android:textColor="@color/tv_text_body"
 app:layout_constraintTop_toBottomOf="@id/iv_thumbnail" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
 <TextView android:id="@+id/tv_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp"
 android:layout_marginHorizontal="4dp" android:layout_marginBottom="4dp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"
 android:textSize="@dimen/ui_text_caption" android:textColor="@color/tv_text_tertiary"
 app:layout_constraintTop_toBottomOf="@id/tv_title" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>