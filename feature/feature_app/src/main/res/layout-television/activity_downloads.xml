<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:paddingStart="48dp"
    android:paddingTop="16dp"
    android:paddingEnd="48dp"
    android:paddingBottom="@dimen/feature_res_spacing_large">

    <!-- 顶部标题与外置存储状态卡片 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title_downloads"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_title"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_import_nas"
            android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="16dp" app:layout_constraintEnd_toStartOf="@id/btn_import_nas" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_import_nas"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/bg_tv_button_focus"
            android:backgroundTint="@null"
            android:paddingHorizontal="14dp"
            android:text="@string/btn_import_nas"
            android:textColor="@color/tv_button_text"
            android:textSize="@dimen/tv_readable_body"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 外置存储卡片 (USB SSD) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_storage_info"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:background="@android:color/transparent"
            android:clipToOutline="true"
            android:paddingStart="@dimen/feature_res_spacing_medium"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/feature_res_spacing_medium"
            android:paddingBottom="10dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_import_nas">

            <TextView
                android:id="@+id/tv_storage_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/tv_text_primary"
                android:textSize="@dimen/tv_readable_body"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/feature_res_spacing_small"
                app:layout_constraintEnd_toStartOf="@id/btn_select_storage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_storage_capacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tv_text_tertiary"
                android:textSize="@dimen/tv_readable_caption"
                app:layout_constraintEnd_toStartOf="@id/btn_select_storage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_storage_label" />

            <Button
                android:id="@+id/btn_select_storage"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_tv_button_focus"
                android:paddingHorizontal="10dp"
                android:text="@string/storage_select_target"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/tv_readable_caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/pb_storage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="22"
                android:progressTint="@color/tv_accent_cyan"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 正在下载区域 -->
    <LinearLayout android:id="@+id/download_sections" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_header_storage" app:layout_constraintEnd_toEndOf="parent">
 <Button android:id="@+id/btn_scan_local" android:layout_width="wrap_content" android:layout_height="wrap_content"  android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:text="@string/storage_scan_now" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" android:focusable="true" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
 <Button android:id="@+id/tv_label_downloading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:text="@string/downloads_local_tab" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" android:focusable="true" />
 <Space android:layout_width="12dp" android:layout_height="1dp" />
 <Button android:id="@+id/btn_download_tasks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:text="@string/downloads_tasks_tab" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" android:focusable="true" />
 </LinearLayout></LinearLayout>

    <!-- 正在下载任务卡片 (Focused Example) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_download_task"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tv_focus_ring"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="@dimen/feature_res_spacing_medium"
        app:layout_constraintTop_toBottomOf="@id/download_sections">

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="汪汪队立大功 S03E05 • 超级狗狗大冲刺.mkv"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_body"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_task_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="18.6 MB/s • 450 MB / 1.2 GB"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="@dimen/tv_readable_caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_task_title" />

        <ProgressBar
            android:id="@+id/pb_task"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginEnd="@dimen/feature_res_spacing_large"
            android:max="100"
            android:progress="38"
            android:progressTint="@color/tv_accent_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ll_task_actions"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/ll_task_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btn_task_pause"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/btn_pause"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/tv_readable_caption" />

            <Button
                android:id="@+id/btn_task_cancel"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/btn_cancel"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/tv_readable_caption" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView android:paddingHorizontal="@dimen/ui_focus_padding"
        android:id="@+id/rv_download_tasks"
        android:nextFocusUp="@+id/tv_label_downloading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/feature_res_spacing_medium"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/download_sections"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:id="@+id/layout_download_tasks_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feature_res_spacing_medium"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/download_sections">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tv_cache_empty_title" android:text="@string/downloads_empty_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_body" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/tv_cache_empty_message" android:text="@string/downloads_empty_message"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/tv_readable_body" />
    </LinearLayout>

    <!-- 已下载媒体海报流 -->
    <TextView
        android:id="@+id/tv_label_downloaded"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/section_downloaded_gallery"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/ui_text_section"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_download_tasks" />

    <androidx.recyclerview.widget.RecyclerView android:paddingHorizontal="@dimen/ui_focus_padding"
        android:id="@+id/rv_downloaded"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false" android:paddingTop="@dimen/ui_focus_padding" android:paddingBottom="@dimen/ui_focus_padding"
        android:orientation="horizontal"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_label_downloaded"
        tools:listitem="@layout/item_poster_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
