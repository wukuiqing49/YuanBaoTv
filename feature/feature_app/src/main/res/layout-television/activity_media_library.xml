<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <!-- 顶部标题与分类过滤栏 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_all_media"
            android:textColor="@color/tv_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 筛选 Tab 按钮组 -->
        <LinearLayout
            android:id="@+id/ll_filter_tabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_all_media"
                android:textColor="@color/tv_text_primary" />

            <Button
                android:id="@+id/btn_filter_cartoon"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_cartoon"
                android:textColor="@color/tv_text_secondary" />

            <Button
                android:id="@+id/btn_filter_tv"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_tv"
                android:textColor="@color/tv_text_secondary" />

            <Button
                android:id="@+id/btn_filter_movie"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_tv_button_focus"
                android:text="@string/nav_movie"
                android:textColor="@color/tv_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 媒体多列网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_media_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        app:spanCount="5"
        tools:listitem="@layout/item_poster_card" />

    <LinearLayout
        android:id="@+id/layout_empty_library"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <ProgressBar android:id="@+id/progress_library" android:layout_width="48dp" android:layout_height="48dp" android:indeterminateTint="@color/tv_accent_cyan" />
        <ImageView android:id="@+id/iv_empty_library" android:layout_width="96dp" android:layout_height="96dp" android:importantForAccessibility="no" android:src="@drawable/bg_media_placeholder_poster" />
        <TextView android:id="@+id/tv_empty_library_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/library_empty_title" android:textColor="@color/tv_text_primary" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_empty_library" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:maxLines="3" android:text="@string/library_empty_message" android:textColor="@color/tv_text_secondary" android:textSize="16sp" />
        <Button android:id="@+id/btn_empty_library_action" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginTop="20dp" android:background="@drawable/bg_hero_play_btn" android:minWidth="152dp" android:text="@string/btn_add_nas" android:textColor="@color/tv_hero_btn_text" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
