<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tv_bg_dark">
    <!-- 背景固定在整个首页画布，内容滚动时不会把背景切成两块。 -->
    <ImageView android:id="@+id/iv_hero_backdrop" android:layout_width="match_parent" android:layout_height="@dimen/home_backdrop_height" android:scaleType="centerCrop"/>
    <View android:id="@+id/v_hero_scrim" android:layout_width="match_parent" android:layout_height="@dimen/home_backdrop_height" android:background="@drawable/bg_home_cinema_scrim"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:paddingTop="72dp" android:paddingBottom="24dp" android:scrollbars="none" android:clipToPadding="true" android:descendantFocusability="afterDescendants">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="48dp" android:clipChildren="false">
            <View android:id="@+id/top_nav_bar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_clock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/layout_hero_content" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_page_inset" android:layout_marginEnd="@dimen/ui_page_inset" android:paddingTop="16dp" android:paddingBottom="16dp" android:orientation="vertical" app:layout_constraintWidth_max="500dp" app:layout_constraintHorizontal_bias="0" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
                <TextView android:id="@+id/tv_hero_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="30sp" android:textColor="@color/tv_text_primary" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"/>
                <TextView android:id="@+id/tv_hero_season_tag" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="@dimen/ui_text_caption" android:textColor="@color/tv_text_tertiary" android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/tv_hero_last_watch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="@dimen/ui_text_caption" android:textColor="@color/tv_text_tertiary" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
                <TextView android:id="@+id/tv_hero_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="@dimen/ui_text_body" android:textColor="@color/tv_text_secondary" android:maxLines="1" android:ellipsize="end"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:clipChildren="false">
                    <Button android:id="@+id/btn_hero_play" android:layout_width="wrap_content" android:layout_height="44dp" android:minHeight="44dp" android:minWidth="128dp" android:background="@drawable/bg_home_primary_button" android:backgroundTint="@null" android:text="@string/btn_play_now" android:textColor="@color/home_primary_text" android:textSize="@dimen/ui_text_action" android:maxLines="1" app:icon="@drawable/ic_tv_play" app:iconTint="@color/home_primary_text" app:iconSize="20dp" app:iconGravity="textStart"/>
                    <Button android:id="@+id/btn_hero_detail" android:layout_width="wrap_content" android:layout_height="44dp" android:minHeight="44dp" android:minWidth="100dp" android:layout_marginStart="12dp" android:background="@drawable/bg_hero_detail_btn" android:backgroundTint="@null" android:text="@string/btn_view_detail" android:textColor="@color/tv_button_text" android:textSize="@dimen/ui_text_action" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/tv_label_continue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_page_inset" android:layout_marginTop="8dp" android:text="@string/section_continue_watching" android:textSize="@dimen/ui_text_section" android:fontFamily="sans-serif-medium" android:textColor="@color/tv_text_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_hero_content"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_continue_watching" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:paddingHorizontal="@dimen/ui_page_inset" android:paddingVertical="@dimen/ui_focus_padding" android:clipToPadding="false" android:clipChildren="false" android:scrollbars="none" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_label_continue"/>
            <TextView android:id="@+id/tv_label_cartoons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ui_page_inset" android:layout_marginTop="16dp" android:text="@string/section_recently_added" android:textSize="@dimen/ui_text_section" android:fontFamily="sans-serif-medium" android:textColor="@color/tv_text_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/rv_continue_watching"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_cartoons" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:paddingHorizontal="@dimen/ui_page_inset" android:paddingVertical="@dimen/ui_focus_padding" android:clipToPadding="false" android:clipChildren="false" android:scrollbars="none" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_label_cartoons"/>
            <include android:id="@+id/home_sections" layout="@layout/layout_home_sections" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/rv_cartoons"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
