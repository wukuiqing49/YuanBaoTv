<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_main_pages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_page_tabs" />

    <View android:layout_width="0dp" android:layout_height="72dp"
        android:background="@drawable/bg_tv_header_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:text="@string/app_name"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layout_page_tabs"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="36dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toEndOf="@id/tv_app_name"
        app:layout_constraintTop_toTopOf="@id/tv_app_name">

        <TextView
            android:id="@+id/tab_home"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="true"
            android:gravity="center"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="96dp"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium"
            android:text="@string/nav_home"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_body" />

        <TextView
            android:id="@+id/tab_library"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="true"
            android:gravity="center"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="96dp"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium"
            android:text="@string/nav_all_media"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ui_text_body" />

        <TextView
            android:id="@+id/tab_downloads"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="true"
            android:gravity="center"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="96dp"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium"
            android:text="@string/nav_downloads"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ui_text_body" />

        <TextView
            android:id="@+id/tab_nas" android:contentDescription="@string/sources_open_description" android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tv_button_focus"
            android:focusable="true"
            android:gravity="center"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="96dp"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium"
            android:text="@string/sources_open_action"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ui_text_body" />
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
