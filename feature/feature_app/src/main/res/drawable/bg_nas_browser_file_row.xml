<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2038BDF8" />
            <stroke android:width="2dp" android:color="@color/tv_focus_ring_gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E24303A" />
            <stroke android:width="2dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2038BDF8" />
            <stroke android:width="1dp" android:color="#8038BDF8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141A1C20" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
