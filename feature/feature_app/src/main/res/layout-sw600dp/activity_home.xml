<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="64dp">

        <!-- 1. 全景电影级大背景 (Figma Node 1:122 Cinematic Hero Background, 高度 460dp) -->
        <ImageView
            android:id="@+id/iv_hero_backdrop"
            android:layout_width="0dp"
            android:layout_height="460dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_glass_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 2. 全景双向暗角渐变遮罩 (左至右 + 下至上全黑过渡到透明) -->
        <View
            android:id="@+id/v_hero_scrim"
            android:layout_width="0dp"
            android:layout_height="460dp"
            android:background="@drawable/bg_hero_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 3. 顶部导航栏 Top Navigation (Figma Node 1:3) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_nav_bar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Brand Logo (1:4) -->
            <TextView
                android:id="@+id/tv_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Navigation Links Pill (1:8 胶囊毛玻璃导航栏) -->
            <LinearLayout
                android:id="@+id/ll_nav_pill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav_pill_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ll_trailing_actions"
                app:layout_constraintStart_toEndOf="@id/tv_logo"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/btn_nav_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:background="@drawable/bg_nav_link_active"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_nav_library"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:background="@drawable/bg_nav_link_active"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_all_media"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_nav_downloads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:background="@drawable/bg_nav_link_active"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_downloads"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_nav_nas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:background="@drawable/bg_nav_link_active"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="NAS"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_nav_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:background="@drawable/bg_nav_link_active"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_settings"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Trailing Actions (1:19 NAS 状态与时钟) -->
            <LinearLayout
                android:id="@+id/ll_trailing_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- NAS 在线微型胶囊 (1:20) -->
                <TextView
                    android:id="@+id/tv_nas_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:background="@drawable/bg_nav_pill_container"
                    android:drawableStart="@drawable/ic_tv_nas"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="NAS 在线"
                    android:textColor="@color/tv_accent_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- 系统时钟 (1:25) -->
                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_nav_pill_container"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="16:08"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 4. Hero 浮动内容区 (直接悬浮在大背景暗部上, Figma Node 1:28) -->
        <LinearLayout
            android:id="@+id/layout_hero_content"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="50dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_nav_bar">

            <!-- 1:30 Heading 1 -->
            <TextView
                android:id="@+id/tv_hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="8"
                android:text="汪汪队立大功"
                android:textColor="@color/tv_text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- 1:32 元数据标签行 (第 3 季 · 动画 + 上次看到：第 5 集) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hero_season_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="第 3 季 · 动画"
                    android:textColor="@color/tv_accent_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hero_last_watch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="上次看到：第 5 集"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hero_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="2"
                android:text="精通科技的10岁男孩莱德救了6条小狗，并将它们训练成了高本领的狗狗巡逻队。无论遇到什么困难，他们总能团结协作化解危机。"
                android:textColor="@color/tv_text_tertiary"
                android:textSize="13sp" />

            <!-- 1:37 操作按钮组 (暖金继续播放 + 毛玻璃详情) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_hero_play"
                    android:layout_width="144dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_hero_gold_btn"
                    android:drawableStart="@drawable/ic_tv_play"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:text="@string/btn_continue_play"
                    android:textColor="@color/tv_hero_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_hero_detail"
                    android:layout_width="110dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_hero_detail_btn"
                    android:focusable="true"
                    android:text="@string/btn_view_detail"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 5. Section 1: 继续观看 (Figma Node 1:48) -->
        <TextView
            android:id="@+id/tv_label_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/section_continue_watching"
            android:textColor="@color/tv_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_hero_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_continue_watching"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_continue"
            tools:listitem="@layout/item_continue_watching" />

        <!-- 6. Section 2: 热门动画片 (Figma Node 1:92) -->
        <TextView
            android:id="@+id/tv_label_cartoons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/section_cartoons"
            android:textColor="@color/tv_text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_continue_watching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cartoons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_cartoons"
            tools:listitem="@layout/item_poster_card" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
