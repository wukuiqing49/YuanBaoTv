<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:padding="@dimen/feature_res_spacing_medium">

    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title_nas_files" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_section" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/card_active_nas" android:layout_width="0dp" android:layout_height="68dp" android:layout_marginTop="@dimen/feature_res_spacing_small" android:background="@drawable/bg_tv_focus_ring" android:focusable="true" android:paddingHorizontal="12dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_title">
        <TextView android:id="@+id/tv_nas_name" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_body" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@id/tv_nas_status" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_nas_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_nas" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_caption" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_nas_host" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_caption" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout android:id="@+id/layout_nas_actions" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/card_active_nas">
            <Button android:id="@+id/btn_scan" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_tv_button_focus" android:ellipsize="end" android:maxLines="1" android:text="@string/btn_scan_now" android:textColor="@color/tv_button_text" android:textSize="@dimen/ui_text_caption" />
            <Button android:id="@+id/btn_test_conn" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_tv_button_focus" android:ellipsize="end" android:maxLines="1" android:text="@string/btn_test_conn" android:textColor="@color/tv_button_text" android:textSize="@dimen/ui_text_caption" />
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/card_add_nas" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_tv_focus_ring" android:focusable="true" android:paddingHorizontal="@dimen/feature_res_spacing_small">
                <TextView android:id="@+id/tv_plus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_section" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <TextView android:id="@+id/tv_add_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/btn_add_nas" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_caption" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/tv_plus" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/layout_file_path" android:layout_width="0dp" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_nas_actions">
        <Button android:id="@+id/btn_file_up" android:layout_width="70dp" android:layout_height="38dp" android:background="@drawable/bg_tv_light_button" android:text="@string/nas_file_up" android:textColor="@color/tv_navigation_text" android:textSize="@dimen/ui_text_caption" />
        <Button android:id="@+id/btn_refresh_files" android:layout_width="64dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_tv_light_button" android:ellipsize="end" android:maxLines="1" android:text="@string/nas_file_refresh" android:textColor="@color/tv_navigation_text" android:textSize="@dimen/ui_text_caption" />
        <TextView android:id="@+id/tv_file_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/feature_res_spacing_small" android:layout_weight="1" android:ellipsize="start" android:maxLines="1" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_caption" />
        <Button android:id="@+id/btn_select_all" android:layout_width="wrap_content" android:layout_height="38dp" android:background="@drawable/bg_tv_light_button" android:text="@string/nas_file_select_all" android:textColor="@color/tv_navigation_text" android:textSize="@dimen/ui_text_caption" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_nas_files" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="@dimen/feature_res_spacing_small" android:scrollbars="none" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintBottom_toTopOf="@id/layout_file_download" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_file_path" />
    <ProgressBar android:id="@+id/progress_nas_files" android:layout_width="44dp" android:layout_height="44dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/rv_nas_files" app:layout_constraintEnd_toEndOf="@id/rv_nas_files" app:layout_constraintStart_toStartOf="@id/rv_nas_files" app:layout_constraintTop_toTopOf="@id/rv_nas_files" />
    <TextView android:id="@+id/tv_nas_files_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nas_file_empty" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_body" android:visibility="gone" app:layout_constraintBottom_toBottomOf="@id/rv_nas_files" app:layout_constraintEnd_toEndOf="@id/rv_nas_files" app:layout_constraintStart_toStartOf="@id/rv_nas_files" app:layout_constraintTop_toTopOf="@id/rv_nas_files" />

    <LinearLayout android:id="@+id/layout_file_download" android:layout_width="0dp" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <TextView android:id="@+id/tv_selected_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_body" />
        <Button android:id="@+id/btn_download_selected" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_hero_play_btn" android:text="@string/nas_file_download_selected" android:textColor="@color/home_primary_text" android:textSize="@dimen/ui_text_caption" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
