<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
        android:padding="@dimen/ui_section_gap">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/player_mode_title" android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_section" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_auto" style="@style/Widget.YuanBaoTv.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_section_gap" android:maxLines="3" android:ellipsize="end"
            android:paddingVertical="@dimen/ui_item_gap" android:text="@string/player_mode_auto" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_internal" style="@style/Widget.YuanBaoTv.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_item_gap" android:maxLines="3" android:ellipsize="end"
            android:paddingVertical="@dimen/ui_item_gap" android:text="@string/player_mode_internal" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_cancel" style="@style/Widget.YuanBaoTv.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_item_gap" android:text="@string/btn_cancel" />
    </LinearLayout>
</ScrollView>
