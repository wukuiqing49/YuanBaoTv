<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="380dp"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_drawer_surface"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingTop="36dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/tv_drawer_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="20dp"
        android:text="@string/player_more_settings"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_settings_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:paddingHorizontal="8dp" android:text="@string/player_group_playback" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_caption" android:accessibilityHeading="true" />
<Button
                android:id="@+id/item_select_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/player_select_episode"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body" />
<Button
                android:id="@+id/item_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="播放倍速: 1.00x" />
<Button
                android:id="@+id/item_skip_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="跳过片头 (关闭)" />
<Button
                android:id="@+id/item_auto_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="自动连播 (本季)" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:paddingHorizontal="8dp" android:text="@string/player_group_tracks" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_caption" android:accessibilityHeading="true" />
<Button
                android:id="@+id/item_audio_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/player_audio_tracks"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body" />
<Button
                android:id="@+id/item_subtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="字幕轨与延迟设置" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:paddingHorizontal="8dp" android:text="@string/player_group_advanced" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_caption" android:accessibilityHeading="true" />
<Button
                android:id="@+id/item_switch_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="切换播放源 (NAS)" />
<Button
                android:id="@+id/item_aspect_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:paddingVertical="12dp" android:textAllCaps="false" android:maxLines="3" android:ellipsize="end"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tv_button_focus"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/ui_text_body"
                tools:text="画面比例 (默认自适应)" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
