<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="760dp"
    android:layout_height="480dp"
    android:background="@drawable/bg_nas_browser_bottom_bar"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 顶部标题与操作栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_cache_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/cache_select_episodes"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nas_browser_text_button"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/cache_select_all"
                android:textColor="@color/tv_navigation_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_cache_confirm"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_nas_browser_download_button"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/nas_file_download_selected"
                android:textColor="@color/home_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_cache_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_button_focus"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/tv_button_text"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 网格列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cache_choices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_cache_choice" />
</LinearLayout>
