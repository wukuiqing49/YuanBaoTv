<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_page_inset" android:background="@drawable/bg_glass_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cache_select_episodes" android:textColor="@color/tv_text_primary" android:textSize="@dimen/ui_text_section" android:maxLines="2" android:ellipsize="end" />
    <Button android:id="@+id/btn_select_all" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/cache_select_all" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_control_text" android:background="@drawable/bg_tv_button_focus" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_cache_choices" android:layout_width="match_parent" android:layout_height="200dp" android:clipToPadding="false" android:scrollbars="none" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btn_cache_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/btn_cancel" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_control_text" android:background="@drawable/bg_tv_button_focus" />
        <Button android:id="@+id/btn_cache_confirm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxLines="2" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_control_text" android:background="@drawable/bg_hero_play_btn" />
    </LinearLayout>
</LinearLayout>
