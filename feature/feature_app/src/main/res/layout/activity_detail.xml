<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layout_detail_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/feature_res_spacing_large">

        <ImageView
            android:id="@+id/iv_backdrop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_detail_backdrop_height"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_glass_card" />

        <LinearLayout
            android:id="@+id/layout_top_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_series_poster"
                android:layout_width="@dimen/phone_detail_poster_width"
                android:layout_height="@dimen/phone_detail_poster_height"
                android:background="@drawable/bg_tv_focus_ring"
                android:focusable="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_glass_card" />

            <LinearLayout
                android:id="@+id/layout_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tv_nas_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_nas" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="@string/detail_badge_series" android:textColor="@color/tv_text_tertiary" android:textSize="@dimen/ui_text_caption" />
                <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/feature_res_spacing_small" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tv_text_primary" android:textSize="@dimen/phone_detail_title_size" android:textStyle="bold" />
                <TextView android:id="@+id/tv_meta_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_accent_cyan" android:textSize="@dimen/ui_text_body" />
                <TextView android:id="@+id/tv_playback_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_caption" android:textColor="@color/tv_text_secondary" android:visibility="gone"/>
                <TextView android:id="@+id/tv_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/feature_res_spacing_small" android:ellipsize="end" android:maxLines="4" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_body" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_res_spacing_medium"
            android:paddingHorizontal="@dimen/feature_res_spacing_medium">
            <Button android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/ui_action_min_height" android:background="@drawable/bg_hero_play_btn" android:maxLines="2" android:text="@string/btn_play_now" android:textColor="@color/home_primary_text" android:textSize="@dimen/ui_text_body" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
            <Button android:id="@+id/btn_download_season" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ui_action_min_height" android:minWidth="0dp" android:paddingHorizontal="12dp" android:background="@drawable/bg_tv_button_focus" android:maxLines="2" android:text="@string/btn_download_season" android:textColor="@color/tv_button_text" android:textSize="@dimen/ui_text_body" />
            <Button android:id="@+id/btn_favorite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ui_action_min_height" android:minWidth="0dp" android:paddingHorizontal="12dp" android:background="@drawable/bg_tv_light_button" android:maxLines="2" android:text="@string/btn_favorite" android:textColor="@color/tv_navigation_text" android:textSize="@dimen/ui_text_body" />
            <Button android:id="@+id/btn_edit_metadata" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ui_action_min_height" android:minWidth="0dp" android:paddingHorizontal="12dp" android:background="@drawable/bg_tv_light_button" android:maxLines="2" android:text="@string/media_edit_metadata" android:textColor="@color/tv_navigation_text" android:textSize="@dimen/ui_text_body" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_playback_mode" style="@style/Widget.YuanBaoTv.Button"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_action_min_height" android:maxLines="1" android:ellipsize="end"
                    android:text="@string/player_mode_button" />
                  <androidx.constraintlayout.helper.widget.Flow android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/feature_res_spacing_small" app:constraint_referenced_ids="btn_download_season,btn_favorite,btn_edit_metadata" app:flow_wrapMode="chain" app:flow_horizontalStyle="packed" app:flow_horizontalBias="0" app:flow_horizontalGap="8dp" app:flow_verticalGap="8dp" app:layout_constraintTop_toBottomOf="@id/btn_play" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/layout_episodes_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_detail_season_bar_height"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="@dimen/feature_res_spacing_medium"
                android:scrollbars="none">
                <LinearLayout android:id="@+id/ll_season_tabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_episode_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/feature_res_spacing_large"
                android:text="@string/detail_no_episodes"
                android:textColor="@color/tv_text_secondary"
                android:textSize="@dimen/ui_text_body"
                android:visibility="gone" />

                    <TextView
            android:id="@+id/tv_episodes_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="@string/detail_episode_hint"
            android:textColor="@color/tv_text_tertiary"
            android:textSize="@dimen/ui_text_caption" />
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/feature_res_spacing_small"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/feature_res_spacing_medium"
                android:paddingEnd="@dimen/feature_res_spacing_medium"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_detail_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ProgressBar
            android:id="@+id/progress_detail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/tv_accent_cyan" />

        <TextView
            android:id="@+id/tv_detail_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_res_spacing_medium"
            android:gravity="center"
            android:text="@string/detail_loading"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/ui_text_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/feature_res_spacing_small"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ui_text_body" />

        <Button
            android:id="@+id/btn_detail_state_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_hero_play_btn"
            android:minWidth="128dp"
            android:text="@string/btn_retry"
            android:textColor="@color/home_primary_text"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
