<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layout_detail_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/iv_backdrop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_detail_backdrop_height"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_glass_card" />

        <LinearLayout
            android:id="@+id/layout_top_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_series_poster"
                android:layout_width="@dimen/phone_detail_poster_width"
                android:layout_height="@dimen/phone_detail_poster_height"
                android:background="@drawable/bg_tv_focus_ring"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_glass_card" />

            <LinearLayout
                android:id="@+id/layout_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tv_nas_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_nas" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="@string/detail_badge_series" android:textColor="@color/tv_text_primary" android:textSize="10sp" />
                <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tv_text_primary" android:textSize="@dimen/phone_detail_title_size" android:textStyle="bold" />
                <TextView android:id="@+id/tv_meta_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_accent_cyan" android:textSize="11sp" />
                <TextView android:id="@+id/tv_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="4" android:textColor="@color/tv_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="@dimen/phone_detail_action_height" android:layout_weight="1" android:background="@drawable/bg_hero_play_btn" android:maxLines="2" android:text="@string/btn_play_now" android:textColor="@color/tv_hero_btn_text" android:textSize="12sp" />
            <Button android:id="@+id/btn_download_season" android:layout_width="0dp" android:layout_height="@dimen/phone_detail_action_height" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_tv_button_focus" android:maxLines="2" android:text="@string/btn_download_season" android:textColor="@color/tv_text_primary" android:textSize="11sp" />
            <Button android:id="@+id/btn_favorite" android:layout_width="84dp" android:layout_height="@dimen/phone_detail_action_height" android:layout_marginStart="8dp" android:background="@drawable/bg_tv_button_focus" android:maxLines="2" android:text="@string/btn_favorite" android:textColor="@color/tv_text_primary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_episodes_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_detail_season_bar_height"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">
                <LinearLayout android:id="@+id/ll_season_tabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_episode_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="@string/detail_no_episodes"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_detail_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ProgressBar
            android:id="@+id/progress_detail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/tv_accent_cyan" />

        <TextView
            android:id="@+id/tv_detail_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/detail_loading"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_detail_state_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_hero_play_btn"
            android:minWidth="128dp"
            android:text="@string/btn_retry"
            android:textColor="@color/tv_hero_btn_text"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
