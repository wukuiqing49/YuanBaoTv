<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/iv_backdrop"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_glass_card" />

        <LinearLayout
            android:id="@+id/layout_top_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_series_poster"
                android:layout_width="108dp"
                android:layout_height="162dp"
                android:background="@drawable/bg_tv_focus_ring"
                android:focusable="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_glass_card" />

            <LinearLayout
                android:id="@+id/layout_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/tv_nas_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_nas" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:text="@string/badge_nas_online" android:textColor="@color/tv_text_primary" android:textSize="10sp" />
                <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tv_text_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_meta_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_accent_cyan" android:textSize="11sp" />
                <TextView android:id="@+id/tv_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="4" android:textColor="@color/tv_text_secondary" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_hero_play_btn" android:maxLines="2" android:text="@string/btn_play_now" android:textColor="@color/tv_hero_btn_text" android:textSize="12sp" />
            <Button android:id="@+id/btn_download_season" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_tv_button_focus" android:maxLines="2" android:text="@string/btn_download_season" android:textColor="@color/tv_text_primary" android:textSize="11sp" />
            <Button android:id="@+id/btn_favorite" android:layout_width="84dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:background="@drawable/bg_tv_button_focus" android:maxLines="2" android:text="@string/btn_favorite" android:textColor="@color/tv_text_primary" android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="18dp"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/ll_season_tabs" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_episodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
