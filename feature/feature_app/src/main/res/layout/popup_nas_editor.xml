<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nas_editor_popup"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_editor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_editor_protocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nas_editor_protocol_hint"
            android:textColor="@color/tv_text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_editor_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nas_popup_stroke" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nas_editor_connection_section"
                android:textColor="@color/tv_accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_name"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:helperText="@string/nas_editor_name_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/group_nas_protocol"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_protocol_smb"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/nas_protocol_smb" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_protocol_webdav"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/nas_protocol_webdav" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_host"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_host"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:helperText="@string/nas_editor_host_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_port"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_port"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_share"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_share"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:helperText="@string/nas_editor_share_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_root"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_root_path"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:helperText="@string/nas_editor_root_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/nas_editor_credentials_section"
                android:textColor="@color/tv_accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_username"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_username"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:helperText="@string/nas_editor_username_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_nas_password"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/nas_password"
                app:boxStrokeColor="@color/nas_popup_stroke"
                app:endIconMode="password_toggle"
                app:helperText="@string/nas_editor_password_hint"
                app:helperTextTextColor="@color/tv_text_tertiary"
                app:hintTextColor="@color/tv_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nas_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="@color/tv_text_primary"
                    android:textColorHint="@color/tv_text_tertiary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nas_popup_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editor_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_nas_editor_secondary_button"
            android:minWidth="88dp"
            android:text="@string/nas_editor_cancel"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editor_test"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nas_editor_secondary_button"
            android:minWidth="88dp"
            android:text="@string/btn_test_conn"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editor_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_nas_editor_primary_button"
            android:minWidth="88dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="@color/nas_popup_action_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
