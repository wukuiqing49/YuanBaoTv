<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title_downloads" android:textColor="@color/tv_text_primary" android:textSize="22sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_storage_info"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_card"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">
        <TextView android:id="@+id/tv_storage_label" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_text_primary" android:textSize="13sp" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@id/btn_select_storage" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_storage_capacity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_text_secondary" android:textSize="11sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_storage_label" />
        <Button android:id="@+id/btn_select_storage" android:layout_width="92dp" android:layout_height="36dp" android:background="@drawable/bg_tv_button_focus" android:text="@string/btn_save" android:textColor="@color/tv_text_primary" android:textSize="11sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <ProgressBar android:id="@+id/pb_storage" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:max="100" android:progressTint="@color/tv_accent_cyan" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView android:id="@+id/tv_label_downloading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/section_downloading" android:textColor="@color/tv_text_primary" android:textSize="17sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/card_storage_info" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_download_task"
        android:layout_width="0dp"
        android:layout_height="126dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_tv_focus_ring"
        android:focusable="true"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_label_downloading">
        <TextView android:id="@+id/tv_task_title" android:layout_width="0dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_text_primary" android:textSize="13sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_task_speed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_accent_cyan" android:textSize="11sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_task_title" />
        <ProgressBar android:id="@+id/pb_task" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="6dp" android:max="100" android:progressTint="@color/tv_accent_blue" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_task_speed" />
        <LinearLayout android:id="@+id/ll_task_actions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/pb_task">
            <Button android:id="@+id/btn_task_pause" android:layout_width="72dp" android:layout_height="36dp" android:background="@drawable/bg_tv_button_focus" android:text="@string/btn_pause" android:textColor="@color/tv_text_primary" android:textSize="11sp" />
            <Button android:id="@+id/btn_task_cancel" android:layout_width="72dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_tv_button_focus" android:text="@string/btn_cancel" android:textColor="@color/tv_text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView android:id="@+id/tv_label_downloaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/section_downloaded_gallery" android:textColor="@color/tv_text_primary" android:textSize="17sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/card_download_task" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_downloaded" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:orientation="horizontal" android:paddingBottom="16dp" android:scrollbars="none" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_label_downloaded" />
</androidx.constraintlayout.widget.ConstraintLayout>
