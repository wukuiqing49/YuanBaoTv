<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_nas_editor_popup">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/media_edit_metadata" android:textColor="@color/tv_text_primary" android:textSize="20sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <EditText android:id="@+id/et_media_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/media_edit_title" android:inputType="textCapSentences" android:maxLength="200" android:singleLine="true" android:textColor="@color/tv_text_primary" android:textColorHint="@color/tv_text_secondary" />
            <EditText android:id="@+id/et_media_year" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/media_edit_year" android:inputType="number" android:maxLength="4" android:singleLine="true" android:textColor="@color/tv_text_primary" android:textColorHint="@color/tv_text_secondary" />
            <EditText android:id="@+id/et_media_genre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/media_edit_genre" android:inputType="text" android:maxLength="200" android:singleLine="true" android:textColor="@color/tv_text_primary" android:textColorHint="@color/tv_text_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/media_edit_type" android:textColor="@color/tv_text_secondary" android:textSize="14sp" />
            <Spinner android:id="@+id/spinner_media_type" android:layout_width="match_parent" android:layout_height="48dp" />
            <EditText android:id="@+id/et_media_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:hint="@string/media_edit_description" android:inputType="textMultiLine" android:maxLength="4000" android:maxLines="4" android:textColor="@color/tv_text_primary" android:textColorHint="@color/tv_text_secondary" />
            <Button android:id="@+id/btn_media_poster" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_tv_button_focus" android:text="@string/media_edit_poster" android:textColor="@color/tv_text_primary" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
        <Button android:id="@+id/btn_editor_cancel" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_tv_button_focus" android:text="@string/btn_cancel" android:textColor="@color/tv_text_primary" />
        <Button android:id="@+id/btn_editor_save" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_tv_button_focus" android:text="@string/media_edit_save" android:textColor="@color/tv_text_primary" />
    </LinearLayout>
</LinearLayout>
