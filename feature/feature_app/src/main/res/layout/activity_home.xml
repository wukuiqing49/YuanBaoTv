<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <View android:id="@+id/top_nav_bar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/tv_clock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_hero_backdrop"
            android:layout_width="0dp"
            android:layout_height="218dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_glass_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/v_hero_scrim"
            android:layout_width="0dp"
            android:layout_height="218dp"
            android:background="@drawable/bg_hero_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/layout_hero_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView android:id="@+id/tv_hero_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/tv_text_primary" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_hero_season_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_tag_pill" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textColor="@color/tv_accent_gold" android:textSize="11sp" />
            <TextView android:id="@+id/tv_hero_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/tv_text_secondary" android:textSize="12sp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_hero_play" android:layout_width="124dp" android:layout_height="42dp" android:background="@drawable/bg_hero_gold_btn" android:text="@string/btn_continue_play" android:textColor="@color/tv_hero_btn_text" android:textSize="12sp" />
                <Button android:id="@+id/btn_hero_detail" android:layout_width="100dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:background="@drawable/bg_hero_detail_btn" android:text="@string/btn_view_detail" android:textColor="@color/tv_text_primary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_label_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/section_continue_watching"
            android:textColor="@color/tv_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_hero_backdrop" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_continue_watching"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_continue" />

        <TextView
            android:id="@+id/tv_label_cartoons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:text="@string/section_cartoons"
            android:textColor="@color/tv_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rv_continue_watching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cartoons"
            android:layout_width="0dp"
            android:layout_height="174dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_label_cartoons" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
