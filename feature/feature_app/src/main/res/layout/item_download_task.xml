<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="120dp"
    android:layout_marginBottom="@dimen/feature_res_spacing_small"
    android:background="@drawable/bg_tv_focus_ring"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/ui_text_body"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_task_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_task_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_local"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/ui_text_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_task_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/tv_text_secondary"
        android:textSize="@dimen/ui_text_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_task_title" />

    <ProgressBar
        android:id="@+id/pb_task"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progressTint="@color/tv_accent_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_task_detail" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/feature_res_spacing_small"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_task">

        <Button
            android:id="@+id/btn_task_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:maxLines="1"
            android:background="@drawable/bg_tv_button_focus"
            android:textColor="@color/tv_control_text"
            android:textSize="@dimen/ui_text_caption" />

        <Button
            android:id="@+id/btn_task_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:maxLines="1"
            android:layout_marginStart="@dimen/feature_res_spacing_small"
            android:background="@drawable/bg_tv_button_focus"
            android:text="@string/btn_cancel"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/ui_text_caption" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
