<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:paddingStart="@dimen/nas_browser_page_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/nas_browser_page_padding"
    android:paddingBottom="12dp">

    <!-- 顶部单行集成控制栏 (52dp) -->
    <HorizontalScrollView android:id="@+id/nas_toolbar_scroll" android:layout_width="0dp" android:layout_height="wrap_content" android:scrollbars="none" android:clipToPadding="false" android:paddingVertical="4dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
    <LinearLayout
        android:id="@+id/layout_file_actions"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_nas_browser_icon_button"
            android:contentDescription="@string/navigation_back"
            android:padding="@dimen/nas_browser_icon_padding"
            android:src="@drawable/ic_nas_back"
            android:tint="@color/tv_navigation_text"
            android:tooltipText="@string/navigation_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/title_nas_files"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 路径面包屑与上级导航 -->
        <Button
            android:id="@+id/btn_file_up"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_nas_browser_text_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/nas_file_up"
            android:textAllCaps="false"
            android:textColor="@color/tv_navigation_text"
            android:textSize="14sp"
            android:tooltipText="@string/nas_file_up" />

        <ImageButton
            android:id="@+id/btn_refresh_files"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_nas_browser_icon_button"
            android:contentDescription="@string/nas_file_refresh"
            android:padding="@dimen/nas_browser_icon_padding"
            android:src="@drawable/ic_nas_refresh"
            android:tint="@color/tv_navigation_text"
            android:tooltipText="@string/nas_file_refresh" />

        <TextView
            android:id="@+id/tv_file_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:maxWidth="180dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            tools:text="/Media/Movies" />

        <!-- 右侧源选择胶囊、全选与编辑 -->
        <Button
            android:id="@+id/btn_nas_source"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nas_browser_source"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="80dp" android:maxWidth="180dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/tv_button_text"
            android:textSize="14sp"
            tools:text="OpenWrt-NAS" />

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_nas_browser_text_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/nas_file_select_all"
            android:textColor="@color/tv_navigation_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_nas_edit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_nas_browser_text_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_edit"
            android:textAllCaps="false"
            android:textColor="@color/tv_navigation_text"
            android:textSize="14sp" />

        <Button android:id="@+id/btn_nas_more" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="12dp" android:text="@string/nas_source_actions" android:textAllCaps="false" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" />
        <!-- 保持兼容但不占位的隐藏 View -->


        <TextView
            android:id="@+id/tv_nas_address"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
    </HorizontalScrollView>


    <LinearLayout android:id="@+id/nas_scan_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp" app:layout_constraintTop_toBottomOf="@id/nas_toolbar_scroll" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tv_nas_scan_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nas_setup_steps" android:textColor="@color/tv_text_secondary" android:textSize="@dimen/ui_text_body" android:maxLines="3" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:clipChildren="false">
            <Button android:id="@+id/btn_nas_scan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:text="@string/btn_scan_now" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <Button android:id="@+id/btn_nas_library" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:text="@string/nas_view_library" android:textAllCaps="false" android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/ui_text_action" android:textColor="@color/tv_button_text" android:background="@drawable/bg_tv_button_focus" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间大视野文件列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nas_files"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/ui_focus_padding"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/nas_browser_list_bottom_padding"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/layout_download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nas_scan_panel" />

    <ProgressBar
        android:id="@+id/progress_nas_files"
        android:layout_width="@dimen/nas_browser_progress_size"
        android:layout_height="@dimen/nas_browser_progress_size"
        android:indeterminateTint="@color/tv_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_nas_files"
        app:layout_constraintEnd_toEndOf="@id/rv_nas_files"
        app:layout_constraintStart_toStartOf="@id/rv_nas_files"
        app:layout_constraintTop_toTopOf="@id/rv_nas_files" />

    <TextView
        android:id="@+id/tv_nas_files_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp" android:minHeight="48dp" android:background="@drawable/bg_tv_button_focus" android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:textColor="@color/tv_text_secondary"
        android:textSize="@dimen/ui_text_body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_nas_files"
        app:layout_constraintEnd_toEndOf="@id/rv_nas_files"
        app:layout_constraintStart_toStartOf="@id/rv_nas_files"
        app:layout_constraintTop_toTopOf="@id/rv_nas_files" />

    <!-- 底部悬浮高亮同步操作栏 -->
    <LinearLayout
        android:id="@+id/layout_download"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_nas_browser_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="已勾选 2 个文件" />

        <Button
            android:id="@+id/btn_download_selected"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_nas_browser_download_button"
            android:minWidth="0dp"
            android:paddingHorizontal="24dp"
            android:text="@string/nas_sync_to_storage"
            android:textColor="@color/home_primary_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
