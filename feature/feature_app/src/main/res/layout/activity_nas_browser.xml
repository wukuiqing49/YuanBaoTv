<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:padding="@dimen/nas_browser_page_padding">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/nas_browser_header_height"
        android:layout_height="@dimen/nas_browser_header_height"
        android:background="@drawable/bg_nas_browser_icon_button"
        android:contentDescription="@string/nas_file_up"
        android:padding="@dimen/nas_browser_icon_padding"
        android:src="@drawable/ic_nas_back"
        android:tooltipText="@string/nas_file_up"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/title_nas_files"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/nas_browser_title_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/btn_nas_edit"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back" />

    <Button
        android:id="@+id/btn_nas_edit"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/nas_browser_header_height"
        android:background="@drawable/bg_nas_browser_text_button"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/nas_browser_action_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_nas_source"
        android:layout_width="0dp"
        android:layout_height="@dimen/nas_browser_header_height"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_nas_browser_source"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:textColor="@color/tv_text_primary"
        android:textSize="@dimen/nas_browser_source_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back" />

    <TextView
        android:id="@+id/tv_nas_address"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/tv_text_secondary"
        android:textSize="@dimen/nas_browser_address_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_nas_source" />

    <LinearLayout
        android:id="@+id/layout_file_actions"
        android:layout_width="0dp"
        android:layout_height="@dimen/nas_browser_action_height"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_nas_source">

        <ImageButton
            android:id="@+id/btn_file_up"
            android:layout_width="@dimen/nas_browser_action_button_height"
            android:layout_height="@dimen/nas_browser_action_button_height"
            android:background="@drawable/bg_nas_browser_icon_button"
            android:contentDescription="@string/nas_file_up"
            android:padding="@dimen/nas_browser_icon_padding"
            android:src="@drawable/ic_nas_back"
            android:tooltipText="@string/nas_file_up" />

        <ImageButton
            android:id="@+id/btn_refresh_files"
            android:layout_width="@dimen/nas_browser_action_button_height"
            android:layout_height="@dimen/nas_browser_action_button_height"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nas_browser_icon_button"
            android:contentDescription="@string/nas_file_refresh"
            android:padding="@dimen/nas_browser_icon_padding"
            android:src="@drawable/ic_nas_refresh"
            android:tooltipText="@string/nas_file_refresh" />

        <TextView
            android:id="@+id/tv_file_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textColor="@color/tv_text_secondary"
            android:textSize="@dimen/nas_browser_path_text_size" />

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nas_browser_action_button_height"
            android:background="@drawable/bg_nas_browser_text_button"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/nas_file_select_all"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/nas_browser_action_text_size" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nas_files"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/nas_browser_list_bottom_padding"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/layout_download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_file_actions" />

    <ProgressBar
        android:id="@+id/progress_nas_files"
        android:layout_width="@dimen/nas_browser_progress_size"
        android:layout_height="@dimen/nas_browser_progress_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_nas_files"
        app:layout_constraintEnd_toEndOf="@id/rv_nas_files"
        app:layout_constraintStart_toStartOf="@id/rv_nas_files"
        app:layout_constraintTop_toTopOf="@id/rv_nas_files" />

    <TextView
        android:id="@+id/tv_nas_files_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tv_text_secondary"
        android:clickable="true"
        android:focusable="true"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_nas_files"
        app:layout_constraintEnd_toEndOf="@id/rv_nas_files"
        app:layout_constraintStart_toStartOf="@id/rv_nas_files"
        app:layout_constraintTop_toTopOf="@id/rv_nas_files" />

    <LinearLayout
        android:id="@+id/layout_download"
        android:layout_width="0dp"
        android:layout_height="@dimen/nas_browser_bottom_height"
        android:background="@drawable/bg_nas_browser_bottom_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/nas_browser_bottom_horizontal_padding"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_text_primary"
            android:textSize="@dimen/nas_browser_selected_text_size" />

        <Button
            android:id="@+id/btn_download_selected"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nas_browser_header_height"
            android:background="@drawable/bg_nas_browser_download_button"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="@string/nas_file_download_selected"
            android:textColor="@color/tv_hero_btn_text"
            android:textSize="@dimen/nas_browser_action_text_size" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
