<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        为占位图声明与海报卡一致的固有尺寸。否则 ImageView 使用 fitCenter 时，
        layer-list 会以中间播放图标的尺寸参与缩放，导致图标被放大到整张卡片。
    -->
    <item
        android:width="108dp"
        android:height="162dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_bg_card" />
            <stroke android:width="1dp" android:color="@color/nas_popup_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:drawable="@drawable/ic_tv_play"
        android:gravity="center" />
</layer-list>
