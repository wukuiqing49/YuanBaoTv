<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263B82F6" />
            <stroke android:width="2dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nas_popup_surface_muted" />
            <stroke android:width="1dp" android:color="@color/nas_popup_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
