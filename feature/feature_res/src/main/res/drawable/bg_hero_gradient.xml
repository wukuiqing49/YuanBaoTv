<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 左至右横向渐变暗角 (保护左侧标题与简介文字) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F5101010"
                android:centerColor="#B3101010"
                android:endColor="#00101010"
                android:type="linear" />
        </shape>
    </item>
    <!-- 2. 下至上纵向渐变暗幕 (与底部背景平滑融合) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F5101010"
                android:centerColor="#80101010"
                android:endColor="#00101010"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
